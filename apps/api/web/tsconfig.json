{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@mz",
    "baseUrl": ".",
    "paths": { "@mz/jsx-runtime": ["src/i18n/jsx-runtime.ts"], "@mz/jsx-dev-runtime": ["src/i18n/jsx-dev-runtime.ts"] },
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
