{
  "name": "@mizan/api",
  "version": "2.0.0",
  "private": true,
  "description": "Mizan ERP v2 — Saudi multi-tenant accounting, POS, inventory and ZATCA e-invoicing",
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "cd web && npm install --include=dev --no-audit --no-fund && npm run build",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "migrate": "node dist/db/migrate.js",
    "test": "node dist/tests/run.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fidm/x509": "^1.2.1",
    "@xmldom/xmldom": "^0.9.12",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "decimal.js": "^10.6.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "xmldsigjs": "^2.8.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
