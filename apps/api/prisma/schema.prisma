// Mizan ERP — production schema
// Security, accounting core, master data, POS, and the operational documents
// that feed automatic journal posting are persisted here. ZATCA phase-two
// signing/clearance state remains intentionally outside this schema for now.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// TENANCY
// ─────────────────────────────────────────────────────────────────────────

model Organization {
  id                     String   @id @default(uuid())
  legalNameAr            String
  legalNameEn            String?
  commercialName         String?
  vatNumber              String?  @unique
  crNumber               String?
  // Sprint 34 — added to match fields OrganizationRow gained across
  // Sprint 29 (org settings) and Sprint 30 (ZATCA seller address for
  // XML generation), which schema.prisma had not been updated to carry.
  requireShiftForPosSale Boolean  @default(false)
  streetName             String?
  buildingNumber         String?
  city                   String?
  postalZone             String?
  district               String?
  countryCode            String?
  phone                  String?
  email                  String?
  invoiceFooter          String?
  defaultReceiptTemplate String   @default("thermal")
  invoiceTemplateConfig  Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  branches          Branch[]
  organizationUsers OrganizationUser[]
  roles             Role[]
  accounts          Account[]
  fiscalYears       FiscalYear[]
  journalEntries    JournalEntry[]
  customers         Customer[]
  suppliers         Supplier[]
  products          Product[]
  posSales          PosSale[]
  salesInvoices     SalesInvoice[]
  purchaseBills     PurchaseBill[]
  expenses          Expense[]
  assets            Asset[]
  payments          Payment[]
  stockLevels       StockLevel[]
  posShifts         PosShift[]
  auditLogs         AuditLog[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid())
  organizationId String
  code           String
  name           String
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  organizationUsers OrganizationUser[]

  @@map("users")
}

// A user's membership + role within ONE organization — this row, not the
// User row itself, is what tenant-scoped authorization checks against.
model OrganizationUser {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  roleId         String
  branchId       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@map("organization_users")
}

model Role {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  isSystem       Boolean  @default(false) // seeded default roles (Owner, Accountant, Cashier, ...)
  createdAt      DateTime @default(now())

  organization      Organization       @relation(fields: [organizationId], references: [id])
  organizationUsers OrganizationUser[]
  rolePermissions   RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

// Global catalog — NOT tenant-scoped (the permission "invoice.post" exists
// once; which roles have it is tenant-scoped via RolePermission).
model Permission {
  id          String  @id @default(uuid())
  code        String  @unique // e.g. "invoice.post", "pos.overrideDiscount"
  module      String // e.g. "invoice", "pos", "journal"
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────────────────
// ACCOUNTING CORE
// ─────────────────────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COST_OF_SALES
  EXPENSE
  OTHER_INCOME
  OTHER_EXPENSE
}

model Account {
  id             String      @id @default(uuid())
  organizationId String
  code           String
  nameAr         String
  nameEn         String?
  type           AccountType
  parentId       String?
  isPostable     Boolean     @default(true) // false = header/group account, cannot receive postings
  isActive       Boolean     @default(true)
  currency       String      @default("SAR")

  organization Organization       @relation(fields: [organizationId], references: [id])
  parent       Account?           @relation("AccountTree", fields: [parentId], references: [id])
  children     Account[]          @relation("AccountTree")
  journalLines JournalEntryLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("accounts")
}

// ─────────────────────────────────────────────────────────────────────────
// MASTER AND OPERATIONAL DATA
// Field names intentionally match the service-layer records so Prisma
// repositories remain thin persistence adapters rather than a second domain.
// ─────────────────────────────────────────────────────────────────────────

model Customer {
  id             String  @id @default(uuid())
  organizationId String
  name           String
  vatNumber      String?
  phone          String?
  email          String?
  crNumber       String?
  streetName     String?
  buildingNumber String?
  city           String?
  postalZone     String?
  district       String?
  countryCode    String? @default("SA")

  organization  Organization   @relation(fields: [organizationId], references: [id])
  posSales      PosSale[]
  salesInvoices SalesInvoice[]

  @@index([organizationId])
  @@map("customers")
}

model PosSale {
  id                      String   @id
  organizationId          String
  customerId              String?
  invoiceNumber           String
  terminalId              String
  periodId                String
  lines                   Json
  tenders                 Json
  subtotal                Decimal  @db.Decimal(18, 4)
  taxTotal                Decimal  @db.Decimal(18, 4)
  total                   Decimal  @db.Decimal(18, 4)
  saleJournalEntryId      String
  inventoryEffects        Json
  remainingQuantities     Json
  status                  String
  shiftId                 String?
  receiptTemplate         String   @default("thermal")
  invoiceTemplateSnapshot Json?
  soldAt                  DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, soldAt])
  @@index([organizationId, customerId])
  @@map("pos_sales")
}

model SalesInvoice {
  id             String   @id
  organizationId String
  customerId     String
  periodId       String   @default("")
  lines          Json
  subtotal       Decimal  @db.Decimal(18, 4)
  taxTotal       Decimal  @db.Decimal(18, 4)
  total          Decimal  @db.Decimal(18, 4)
  paidAmount     Decimal  @default(0) @db.Decimal(18, 4)
  journalEntryId String   @unique
  issueDate      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])

  @@index([organizationId, issueDate])
  @@index([organizationId, customerId])
  @@index([organizationId, periodId])
  @@map("sales_invoices")
}

model Supplier {
  id             String  @id @default(uuid())
  organizationId String
  name           String
  vatNumber      String?
  phone          String?
  email          String?

  organization  Organization   @relation(fields: [organizationId], references: [id])
  purchaseBills PurchaseBill[]

  @@index([organizationId])
  @@map("suppliers")
}

model Product {
  id             String  @id @default(uuid())
  organizationId String
  sku            String
  name           String
  unit           String
  sellingPrice   Decimal @db.Decimal(18, 4)
  taxCode        String // "STANDARD" | "ZERO" | "EXEMPT" | "OUT_OF_SCOPE" — kept as a plain string, not a Prisma enum, matching the TS union already used in ProductRow (see products.service.ts) rather than introducing a second source of truth for this list

  organization Organization @relation(fields: [organizationId], references: [id])
  stockLevels  StockLevel[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@map("products")
}

model PurchaseBill {
  id             String   @id
  organizationId String
  supplierId     String
  periodId       String   @default("")
  lines          Json
  subtotal       Decimal  @db.Decimal(18, 4)
  taxTotal       Decimal  @db.Decimal(18, 4)
  total          Decimal  @db.Decimal(18, 4)
  paidAmount     Decimal  @default(0) @db.Decimal(18, 4)
  journalEntryId String   @unique
  issueDate      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  supplier     Supplier     @relation(fields: [supplierId], references: [id])

  @@index([organizationId, issueDate])
  @@index([organizationId, supplierId])
  @@index([organizationId, periodId])
  @@map("purchase_bills")
}

model Expense {
  id                 String   @id
  organizationId     String
  periodId            String   @default("")
  expenseAccountCode String
  paymentAccountCode String
  amount             Decimal  @db.Decimal(18, 4)
  taxCode            String   @default("STANDARD")
  taxAmount          Decimal  @db.Decimal(18, 4)
  total              Decimal  @db.Decimal(18, 4)
  description        String
  journalEntryId     String   @unique
  createdAt          DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, periodId])
  @@map("expenses")
}

model Asset {
  id                        String   @id
  organizationId            String
  name                      String
  cost                      Decimal  @db.Decimal(18, 4)
  residualValue             Decimal  @db.Decimal(18, 4)
  usefulLifeMonths          Int
  accumulatedDepreciation   Decimal  @default(0) @db.Decimal(18, 4)
  acquisitionJournalEntryId String   @unique
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("assets")
}

model Payment {
  id             String   @id
  organizationId String
  type           String
  partyId        String
  amount         Decimal  @db.Decimal(18, 4)
  journalEntryId String   @unique
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, type, partyId])
  @@map("payments")
}

model StockLevel {
  organizationId String
  productId      String
  quantityOnHand Decimal  @default(0) @db.Decimal(18, 4)
  averageCost    Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@id([organizationId, productId])
  @@index([productId])
  @@map("stock_levels")
}

model PosShift {
  id               String    @id @default(uuid())
  organizationId   String
  terminalId       String
  cashierUserId    String
  openingCash      Decimal   @db.Decimal(18, 4)
  cashSalesTotal   Decimal   @default(0) @db.Decimal(18, 4)
  cashReturnsTotal Decimal   @default(0) @db.Decimal(18, 4)
  status           String
  actualCash       Decimal?  @db.Decimal(18, 4)
  expectedCash     Decimal?  @db.Decimal(18, 4)
  cashDifference   Decimal?  @db.Decimal(18, 4)
  openedAt         DateTime  @default(now())
  closedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, terminalId, status])
  @@map("pos_shifts")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String?
  branchId       String?
  action         String
  entityPath     String
  requestBody    Json?
  outcome        String
  errorMessage   String?
  timestamp      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, timestamp])
  @@index([action, timestamp])
  @@map("audit_logs")
}

enum PeriodStatus {
  OPEN
  SOFT_CLOSED
  CLOSED
  LOCKED
}

model FiscalYear {
  id             String       @id @default(uuid())
  organizationId String
  startDate      DateTime
  endDate        DateTime
  status         PeriodStatus @default(OPEN)

  organization Organization       @relation(fields: [organizationId], references: [id])
  periods      AccountingPeriod[]

  @@index([organizationId])
  @@map("fiscal_years")
}

model AccountingPeriod {
  id           String       @id @default(uuid())
  fiscalYearId String
  startDate    DateTime
  endDate      DateTime
  status       PeriodStatus @default(OPEN)

  fiscalYear     FiscalYear     @relation(fields: [fiscalYearId], references: [id])
  journalEntries JournalEntry[]

  @@index([fiscalYearId])
  @@map("accounting_periods")
}

enum JournalSourceEvent {
  MANUAL_JOURNAL_POSTED
  SALE_INVOICE_POSTED
  POS_SALE_COMPLETED
  POS_RETURN_COMPLETED
  PURCHASE_BILL_POSTED
  PURCHASE_RETURN_COMPLETED
  PAYMENT_RECEIVED
  PAYMENT_PAID
  EXPENSE_POSTED
  INVENTORY_RECEIVED
  INVENTORY_ISSUED
  STOCK_ADJUSTED
  ASSET_ACQUIRED
  ASSET_DEPRECIATED
  BANK_TRANSFER
  PERIOD_CLOSED
}

// Written ONLY by the AccountingPostingEngine. No other module writes here
// directly — see docs/ARCHITECTURE.md §4.
model JournalEntry {
  id             String             @id @default(uuid())
  organizationId String
  branchId       String?
  periodId       String
  sourceEvent    JournalSourceEvent
  sourceDocId    String? // e.g. invoice_documents.id, pos_sales.id — no FK yet, those tables don't exist in Phase 0
  reference      String?
  postedAt       DateTime           @default(now())
  reversedById   String?            @unique // points to the reversing JournalEntry, if any
  isReversal     Boolean            @default(false)

  organization Organization       @relation(fields: [organizationId], references: [id])
  period       AccountingPeriod   @relation(fields: [periodId], references: [id])
  lines        JournalEntryLine[]

  @@index([organizationId])
  @@index([periodId])
  @@map("journal_entries")
}

/// Backs the idempotency guarantee in AccountingPostingEngine.post() (spec
/// band 91). The unique constraint is what actually prevents a duplicate
/// financial transaction under concurrent retries — the application-level
/// find-then-create in the engine is a fast path, not the real guarantee;
/// a race would still be caught here by Postgres rejecting the second
/// insert, which the engine should treat as "already posted" and re-fetch.
model IdempotencyKey {
  organizationId String
  key            String
  journalEntryId String
  createdAt      DateTime @default(now())

  @@id([organizationId, key])
  @@map("idempotency_keys")
}

model JournalEntryLine {
  id             String  @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Decimal @default(0) @db.Decimal(18, 4)
  credit         Decimal @default(0) @db.Decimal(18, 4)
  costCenterId   String?
  description    String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}
